# Kernel fragment for AgentCell OS.
# Merge with:  scripts/kconfig/merge_config.sh .config os/kernel/agentcell.config
# Then:        make olddefconfig && make -j$(nproc)
#
# This is NOT a full .config. Start from a distro config (Arch/linux) or
# tinyconfig, then merge this file.

# --- isolation (required) ---
CONFIG_USER_NS=y
CONFIG_PID_NS=y
CONFIG_NET_NS=y
CONFIG_IPC_NS=y
CONFIG_UTS_NS=y
CONFIG_CGROUPS=y
CONFIG_MEMCG=y
CONFIG_CGROUP_SCHED=y
CONFIG_CGROUP_PIDS=y
CONFIG_BLK_CGROUP=y
CONFIG_SECCOMP=y
CONFIG_SECCOMP_FILTER=y
CONFIG_SECURITY_LANDLOCK=y

# BPF LSM: one host daemon, not per-cell
CONFIG_BPF_SYSCALL=y
CONFIG_BPF_LSM=y
CONFIG_BPF_JIT=y
CONFIG_DEBUG_INFO_BTF=y

# cell root + overlays
CONFIG_OVERLAY_FS=y
CONFIG_EROFS_FS=y
CONFIG_SQUASHFS=y
CONFIG_TMPFS=y
CONFIG_DEVTMPFS=y

# --- speed / dedicated host ---
# Prefer throughput over desktop latency; drop debug tax.
# CONFIG_PREEMPT is y on Arch desktop; dedicated box:
# CONFIG_PREEMPT_NONE=y
CONFIG_NO_HZ=y
CONFIG_HIGH_RES_TIMERS=y
CONFIG_IKCONFIG=y
CONFIG_IKCONFIG_PROC=y

# --- keep off the agent hot path ---
# CONFIG_SECURITY_APPARMOR is y on Ubuntu; disable on this host.
# CONFIG_SECURITY_SELINUX=n
# CONFIG_IMA=n
# CONFIG_LOCKDEP=n
# CONFIG_KASAN=n
